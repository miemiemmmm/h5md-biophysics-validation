+TEST_P(H5mdTopologyBenchmarkTest, BenchmarkDecomposeWritingProcess)
+{
+    //! \brief Group name for all atoms in system.
+    constexpr char c_fullSystemGroupName[] = "system";
+
+    const std::string tprPath = kTprBaseDir + "/" + GetParam();
+    if (!std::filesystem::exists(tprPath))
+    {
+        GTEST_SKIP() << "TPR file not found: " << tprPath;
+    }
+
+    t_inputrec inputRecord;
+    gmx_mtop_t topology;
+    matrix     box;
+    int        numAtoms;
+    read_tpx(tprPath, &inputRecord, box, &numAtoms, nullptr, nullptr, &topology);
+    ASSERT_GT(numAtoms, 0) << "Failed to read number of atoms from " << tprPath;
+
+    auto metadataStart = std::chrono::high_resolution_clock::now();
+    file().setupMetadataGroup();
+    auto metadataEnd = std::chrono::high_resolution_clock::now();
+    auto metadataElapsedUs =
+            std::chrono::duration_cast<std::chrono::microseconds>(metadataEnd - metadataStart).count();
+
+    auto pbStart = std::chrono::high_resolution_clock::now();
+    file().setupParticleBlockForGroup(topology, {}, c_fullSystemGroupName, inputRecord);
+    auto pbEnd = std::chrono::high_resolution_clock::now();
+    auto pbElapsedUs = std::chrono::duration_cast<std::chrono::microseconds>(pbEnd - pbStart).count();
+
+    // Topology information and system title/version
+    auto topStart = std::chrono::high_resolution_clock::now();
+    file().setupGromacsTopology(topology);
+    auto topEnd = std::chrono::high_resolution_clock::now();
+    auto topElapsedUs = std::chrono::duration_cast<std::chrono::microseconds>(topEnd - topStart).count();
+
+    // Bond connectivity (/connectivity)
+    auto bondStart = std::chrono::high_resolution_clock::now();
+    file().setupBondConnectivity(topology);
+    auto bondEnd = std::chrono::high_resolution_clock::now();
+    auto bondElapsedUs =
+            std::chrono::duration_cast<std::chrono::microseconds>(bondEnd - bondStart).count();
+
+    // Force field parameters (/force_field)
+    auto ffStart = std::chrono::high_resolution_clock::now();
+    file().setupForceFieldParameters(topology.ffparams, inputRecord.efep != FreeEnergyPerturbationType::No);
+    auto ffEnd = std::chrono::high_resolution_clock::now();
+    auto ffElapsedUs = std::chrono::duration_cast<std::chrono::microseconds>(ffEnd - ffStart).count();
+
+    // MD parameters (/parameters)
+    auto mdParamsStart = std::chrono::high_resolution_clock::now();
+    file().setupMDParameters(inputRecord, topology, false);
+    auto mdParamsEnd = std::chrono::high_resolution_clock::now();
+    auto mdParamsElapsedUs =
+            std::chrono::duration_cast<std::chrono::microseconds>(mdParamsEnd - mdParamsStart).count();
+
+    // Selection groups (/selections)
+    auto selStart = std::chrono::high_resolution_clock::now();
+    file().setupIndexGroups(topology);
+    auto selEnd = std::chrono::high_resolution_clock::now();
+    auto selElapsedUs = std::chrono::duration_cast<std::chrono::microseconds>(selEnd - selStart).count();
+
+    RecordProperty("natoms", topology.natoms);
+    RecordProperty("metadata_elapsed_us", static_cast<long long>(metadataElapsedUs));
+    RecordProperty("particle_block_elapsed_us", static_cast<long long>(pbElapsedUs));
+    RecordProperty("topology_elapsed_us", static_cast<long long>(topElapsedUs));
+    RecordProperty("bond_connectivity_elapsed_us", static_cast<long long>(bondElapsedUs));
+    RecordProperty("force_field_elapsed_us", static_cast<long long>(ffElapsedUs));
+    RecordProperty("md_parameters_elapsed_us", static_cast<long long>(mdParamsElapsedUs));
+    RecordProperty("selection_groups_elapsed_us", static_cast<long long>(selElapsedUs));
+}
