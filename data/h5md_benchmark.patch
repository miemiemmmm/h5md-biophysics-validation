+//! Fixture combining H5mdTestBase (temp HDF5 file) with parameterization over tpr paths.
+class H5mdTopologyBenchmarkTest : public H5mdTestBase, public ::testing::WithParamInterface<std::string>
+{
+};
+
+INSTANTIATE_TEST_SUITE_P(BenchmarkTprs, H5mdTopologyBenchmarkTest, ::testing::ValuesIn(kBenchmarkTprFiles));
+
+TEST_P(H5mdTopologyBenchmarkTest, BenchmarkAsFlatTopology)
+{
+    const std::string tprPath = kTprBaseDir + "/" + GetParam();
+    if (!std::filesystem::exists(tprPath))
+    {
+        GTEST_SKIP() << "TPR file not found: " << tprPath;
+    }
+
+    t_inputrec inputRecord;
+    gmx_mtop_t topology;
+    matrix     box;
+    int        numAtoms;
+    read_tpx(tprPath, &inputRecord, box, &numAtoms, nullptr, nullptr, &topology);
+    ASSERT_GT(numAtoms, 0) << "Failed to read number of atoms from " << tprPath;
+
+    AtomRange atomRange(topology);
+    const auto [container, containerGuard] =
+            makeH5mdGroupGuard(createGroup(fileid(), "/benchmark_compound/particles"));
+
+    auto t0 = std::chrono::high_resolution_clock::now();
+    writeCompoundTopologyData(atomRange, container);
+    H5Fflush(fileid(), H5F_SCOPE_LOCAL);
+    auto t1        = std::chrono::high_resolution_clock::now();
+    auto elapsedUs = std::chrono::duration_cast<std::chrono::microseconds>(t1 - t0).count();
+
+    hsize_t fileSizeBytes = 0;
+    H5Fget_filesize(fileid(), &fileSizeBytes);
+
+    std::printf("  [compound ] %-44s  atoms=%7d  time=%lld us  size=%llu B\n",
+                GetParam().c_str(),
+                topology.natoms,
+                static_cast<long long>(elapsedUs),
+                static_cast<unsigned long long>(fileSizeBytes));
+
+    RecordProperty("natoms", topology.natoms);
+    RecordProperty("elapsed_us", static_cast<long long>(elapsedUs));
+    RecordProperty("file_size_bytes", static_cast<long long>(fileSizeBytes));
+
+    SUCCEED();
+}
